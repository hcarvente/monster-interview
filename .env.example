# Copy this file to .env.local and put your real key there.
# .env.local is git-ignored. NEVER commit a real key.
# Do NOT add a NEXT_PUBLIC_ prefix: that would expose the key to the browser.
GEMINI_API_KEY=your-key-goes-here
# Model id is confirmed against Google's docs in Step 6b before use.
GEMINI_MODEL=gemini-2.5-flash-lite
